KITE_API_KEY=your_kite_api_key
KITE_ACCESS_TOKEN=your_daily_access_token
OPENAI_API_KEY=
OPENAI_ANALYST_MODEL=gpt-5.6-terra
# Optional Gemini chatbot. Supported models may have a limited free tier.
GEMINI_API_KEY=
GEMINI_ANALYST_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# always: make Google Search available to every Gemini request; auto: current-info questions only; off: disabled.
GEMINI_WEB_SEARCH=always
# Optional local, no-API-billing analyst provider.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_ANALYST_MODEL=gpt-oss:20b
# Optional absolute path when the Codex CLI is not on PATH.
CODEX_EXECUTABLE=codex
MARKET_DATA_SOURCE=kite
TRADING_STRATEGY_MODE=both
NEWS_MAX_AGE_HOURS=72
ENTRY_MIN_CLOSE_LOCATION=0.60
ENTRY_NORMAL_EXTENSION_ATR=1.00
ENTRY_MAX_EXTENSION_ATR=1.50
ENTRY_NO_CHASE_EXTENSION_ATR=2.00
BREAKOUT_RETEST_TOLERANCE_ATR=0.25
BREAKOUT_CONSOLIDATION_MAX_RANGE_ATR=0.80
BULLISH_MAX_ADVERSE_MOVE_PERCENT=3.00
BULLISH_MIN_ADVERSE_HOLD_PROBABILITY=70.00
BULLISH_BARRIER_HORIZON_DAYS=5
BULLISH_BARRIER_MINIMUM_SAMPLES=60
BULLISH_INTRADAY_BARRIER_MINIMUM_SAMPLES=30
# A large daily fall becomes a 15-minute reversal watch. It is executable only
# after demand, market structure, VWAP, volume and reward/risk confirmation.
RECOVERY_SHOCK_FLOOR_PERCENT=4.00
RECOVERY_SHOCK_ATR_MULTIPLE=1.50
RECOVERY_MINIMUM_SCORE=70.00
RECOVERY_MINIMUM_RISK_REWARD=1.50
RECOVERY_GREEN_RED_VOLUME_RATIO=1.10
BULLISH_MAX_TECHNICAL_STOP_PERCENT=3.00
BULLISH_MIN_TARGET_BEFORE_ADVERSE_PROBABILITY=55.00
BULLISH_MIN_NO_OVERNIGHT_GAP_PROBABILITY=95.00
BULLISH_MIN_RELATIVE_STRENGTH_SCORE=55.00
BEARISH_MAX_TECHNICAL_STOP_PERCENT=3.00
BEARISH_MIN_TARGET_BEFORE_ADVERSE_PROBABILITY=55.00
BEARISH_MIN_NO_OVERNIGHT_GAP_PROBABILITY=95.00
BEARISH_MAX_RELATIVE_STRENGTH_PERCENT=0.00
BEARISH_MAX_SECTOR_SCORE=45.00
ENTRY_MAX_CONSECUTIVE_BULLISH_CANDLES=4
TRADING_CAPITAL=100000
TRADING_RISK_PERCENT=1
OPTION_CAPITAL=2500000
OPTION_RISK_PER_TRADE=100000
# Two-stage Daily Report screening
LIGHTWEIGHT_SUPPORT_LOOKBACK=20
LIGHTWEIGHT_SUPPORT_DISTANCE_PCT=2.0
LIGHTWEIGHT_BREAKOUT_LOOKBACK=20
LIGHTWEIGHT_STOP_ATR_BUFFER=0.2
LIGHTWEIGHT_LIVE_MAX_AGE_SECONDS=120
USE_LIGHTWEIGHT_INITIAL_SUPPORT=true
INITIAL_SCAN_WORKERS=8
RANKING_SHORTLIST_SIZE=20
FINAL_REPORT_LIMIT=5
ENRICHMENT_BUFFER=5
ADVANCED_ANALYSIS_MAX_CANDIDATES=30
OPTION_ANALYSIS_MAX_CANDIDATES=10
MIN_TECHNICAL_SCORE=40
ENABLE_STAGE_TIMINGS=true
ENABLE_PER_SYMBOL_TIMINGS=false
RANKING_MODE=SHADOW
BULLISH_RVOL_THRESHOLD=1.2
BREAKOUT_RVOL_THRESHOLD=1.2
BEARISH_RVOL_THRESHOLD=1.2
MIN_CANDLE_BODY_PCT=0.5
CLOSE_LOCATION_BULLISH_THRESHOLD=0.7
CLOSE_LOCATION_BEARISH_THRESHOLD=0.3
MIN_BUY_RISK_REWARD=1.5
PREFERRED_RISK_REWARD=2.0
MIN_STOP_ATR=0.25
MAX_STOP_ATR=3.0
MAX_RISK_PERCENT=3.0
EVENT_CRITICAL_DAYS=1
EVENT_HIGH_RISK_DAYS=3
EVENT_CAUTION_DAYS=7
MAX_INITIAL_CANDIDATES_PER_SECTOR=5
MAX_FINAL_POSITIONS_PER_SECTOR=2
MAX_SECTOR_CAPITAL_PERCENT=25
MAX_CORRELATION=0.85
CORRELATION_LOOKBACK=60
MIN_OPTION_OI=10000
MIN_OPTION_VOLUME=1000
MAX_BID_ASK_SPREAD_PCT=5
MIN_STRIKE_DISTANCE_ATR=1.5
MIN_STRIKE_DISTANCE_PCT=5
MIN_OPTION_SELL_SCORE=65
MAX_MARGIN_PER_TRADE=100000
BLOCK_EARNINGS_OPTION_SELLING=true
FUNDAMENTAL_MISSING_POLICY=REJECT
EVENT_MISSING_POLICY=NEUTRAL
SECTOR_MISSING_POLICY=NEUTRAL
INTRADAY_MISSING_POLICY=RENORMALIZE
MAX_SECTOR_PE_DEVIATION=0.05
MIN_ROE_PERCENT=15
MIN_ROCE_PERCENT=15
