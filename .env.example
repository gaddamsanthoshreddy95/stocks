KITE_API_KEY=your_kite_api_key
KITE_ACCESS_TOKEN=your_daily_access_token
OPENAI_API_KEY=
OPENAI_ANALYST_MODEL=gpt-5.6-terra
# Optional Gemini chatbot. Supported models may have a limited free tier.
GEMINI_API_KEY=
GEMINI_ANALYST_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# always: make Google Search available to every Gemini request; auto: current-info questions only; off: disabled.
GEMINI_WEB_SEARCH=always
# Optional local, no-API-billing analyst provider.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_ANALYST_MODEL=gpt-oss:20b
# Optional absolute path when the Codex CLI is not on PATH.
CODEX_EXECUTABLE=codex
MARKET_DATA_SOURCE=kite
TRADING_STRATEGY_MODE=both
NEWS_MAX_AGE_HOURS=72
ENTRY_MIN_CLOSE_LOCATION=0.60
ENTRY_NORMAL_EXTENSION_ATR=1.00
ENTRY_MAX_EXTENSION_ATR=1.50
ENTRY_NO_CHASE_EXTENSION_ATR=2.00
BREAKOUT_RETEST_TOLERANCE_ATR=0.25
BREAKOUT_CONSOLIDATION_MAX_RANGE_ATR=0.80
BULLISH_MAX_ADVERSE_MOVE_PERCENT=3.00
BULLISH_MIN_ADVERSE_HOLD_PROBABILITY=70.00
BULLISH_BARRIER_HORIZON_DAYS=5
BULLISH_BARRIER_MINIMUM_SAMPLES=60
BULLISH_INTRADAY_BARRIER_MINIMUM_SAMPLES=30
# A large daily fall becomes a 15-minute reversal watch. It is executable only
# after demand, market structure, VWAP, volume and reward/risk confirmation.
RECOVERY_SHOCK_FLOOR_PERCENT=4.00
RECOVERY_SHOCK_ATR_MULTIPLE=1.50
RECOVERY_MINIMUM_SCORE=70.00
RECOVERY_MINIMUM_RISK_REWARD=1.50
RECOVERY_GREEN_RED_VOLUME_RATIO=1.10
BULLISH_MAX_TECHNICAL_STOP_PERCENT=3.00
BULLISH_MIN_TARGET_BEFORE_ADVERSE_PROBABILITY=55.00
BULLISH_MIN_NO_OVERNIGHT_GAP_PROBABILITY=95.00
BULLISH_MIN_RELATIVE_STRENGTH_SCORE=55.00
BEARISH_MAX_TECHNICAL_STOP_PERCENT=3.00
BEARISH_MIN_TARGET_BEFORE_ADVERSE_PROBABILITY=55.00
BEARISH_MIN_NO_OVERNIGHT_GAP_PROBABILITY=95.00
BEARISH_MAX_RELATIVE_STRENGTH_PERCENT=0.00
BEARISH_MAX_SECTOR_SCORE=45.00
ENTRY_MAX_CONSECUTIVE_BULLISH_CANDLES=4
TRADING_CAPITAL=100000
TRADING_RISK_PERCENT=1
OPTION_CAPITAL=2500000
OPTION_RISK_PER_TRADE=100000
# Two-stage Daily Report screening
LIGHTWEIGHT_SUPPORT_LOOKBACK=20
LIGHTWEIGHT_SUPPORT_DISTANCE_PCT=2.0
LIGHTWEIGHT_BREAKOUT_LOOKBACK=20
LIGHTWEIGHT_STOP_ATR_BUFFER=0.2
LIGHTWEIGHT_LIVE_MAX_AGE_SECONDS=120
USE_LIGHTWEIGHT_INITIAL_SUPPORT=true
INITIAL_SCAN_WORKERS=8
RANKING_SHORTLIST_SIZE=20
FINAL_REPORT_LIMIT=5
ENRICHMENT_BUFFER=5
ADVANCED_ANALYSIS_MAX_CANDIDATES=30
OPTION_ANALYSIS_MAX_CANDIDATES=10
MIN_TECHNICAL_SCORE=40
ENABLE_STAGE_TIMINGS=true
ENABLE_PER_SYMBOL_TIMINGS=false
RANKING_MODE=SHADOW
BULLISH_RVOL_THRESHOLD=1.2
BREAKOUT_RVOL_THRESHOLD=1.2
BEARISH_RVOL_THRESHOLD=1.2
MIN_CANDLE_BODY_PCT=0.5
CLOSE_LOCATION_BULLISH_THRESHOLD=0.7
CLOSE_LOCATION_BEARISH_THRESHOLD=0.3
MIN_BUY_RISK_REWARD=1.5
PREFERRED_RISK_REWARD=2.0
MIN_STOP_ATR=0.25
MAX_STOP_ATR=3.0
MAX_RISK_PERCENT=3.0
EVENT_CRITICAL_DAYS=1
EVENT_HIGH_RISK_DAYS=3
EVENT_CAUTION_DAYS=7
MAX_INITIAL_CANDIDATES_PER_SECTOR=5
MAX_FINAL_POSITIONS_PER_SECTOR=2
MAX_SECTOR_CAPITAL_PERCENT=25
MAX_CORRELATION=0.85
CORRELATION_LOOKBACK=60
MIN_OPTION_OI=10000
MIN_OPTION_VOLUME=1000
MAX_BID_ASK_SPREAD_PCT=5
MIN_STRIKE_DISTANCE_ATR=1.5
MIN_STRIKE_DISTANCE_PCT=5
MIN_OPTION_SELL_SCORE=65
MAX_MARGIN_PER_TRADE=100000
BLOCK_EARNINGS_OPTION_SELLING=true
FUNDAMENTAL_MISSING_POLICY=REJECT
EVENT_MISSING_POLICY=NEUTRAL
SECTOR_MISSING_POLICY=NEUTRAL
INTRADAY_MISSING_POLICY=RENORMALIZE
MAX_SECTOR_PE_DEVIATION=0.05
MIN_ROE_PERCENT=15
MIN_ROCE_PERCENT=15

# Exact-contract futures execution freshness (seconds).
FUTURES_MAXIMUM_QUOTE_AGE_SECONDS=120
FUTURES_MAXIMUM_CANDLE_AGE_SECONDS=600

# Independent full-universe LONG/SHORT discovery and execution hypotheses.
FUTURES_SCAN_MINIMUM_SCORE=60
FUTURES_SCAN_WATCH_SCORE=40
FUTURES_SCAN_REVIEW_PER_DIRECTION=20
FUTURES_SCAN_MINIMUM_HISTORICAL_SIGNALS=30
FUTURES_SCAN_TARGET_FRACTION=0.003
FUTURES_SCAN_STOP_FRACTION=0.002
FUTURES_SCAN_MINIMUM_NET_RR=1.0
FUTURES_SCAN_MAXIMUM_LOTS=1
FUTURES_SCAN_MAXIMUM_MOVE_PERCENT=2
FUTURES_SCAN_MAXIMUM_ATR_CONSUMED=1
FUTURES_SCAN_MAXIMUM_EXTENSION_ATR=1.5
FUTURES_SCAN_MAXIMUM_VWAP_EXTENSION_PERCENT=1
FUTURES_SCAN_MINIMUM_ADX=25
FUTURES_SCAN_MINIMUM_RVOL=1.2
FUTURES_SCAN_BEARISH_RSI_LOW=30
FUTURES_SCAN_BEARISH_RSI_HIGH=45
FUTURES_SCAN_MAXIMUM_SLIPPAGE_BPS=10
FUTURES_SCAN_MAXIMUM_PARTICIPATION=0.1
FUTURES_SCAN_SHORT_COVERING_PRICE_PERCENT=0.05
FUTURES_SCAN_SHORT_COVERING_OI_PERCENT=0.1
FUTURES_SCAN_SHORT_OVERSOLD_RSI=30
FUTURES_SCAN_SHORT_FRESH_BREAKDOWN_BARS=2
FUTURES_SCAN_SHORT_RETEST_TOLERANCE_ATR=0.15
FUTURES_SCAN_SHORT_MAXIMUM_TRIGGER_DISTANCE_PERCENT=0.1
FUTURES_SCAN_OUT_OF_SAMPLE_FRACTION=0.3
FUTURES_SCAN_BEARISH_TREND_WEIGHT=0.25
FUTURES_SCAN_BEARISH_MOMENTUM_WEIGHT=0.20
FUTURES_SCAN_BEARISH_VOLUME_WEIGHT=0.15
FUTURES_SCAN_BEARISH_STRUCTURE_WEIGHT=0.15
FUTURES_SCAN_BEARISH_SECTOR_WEIGHT=0.10
FUTURES_SCAN_BEARISH_OPPORTUNITY_WEIGHT=0.15
FUTURES_COST_BROKERAGE_RATE=0.0003
FUTURES_COST_BROKERAGE_CAP=20
FUTURES_COST_EXCHANGE_RATE=0.0000183
FUTURES_COST_SEBI_RATE=0.000001
FUTURES_COST_GST_RATE=0.18
FUTURES_COST_STAMP_RATE=0.00002
FUTURES_COST_SLIPPAGE_BPS=2

# Prepared scanner: CLI/API/UI default to LIVE_SCAN; research is outside the live path.
FUTURES_RUNTIME_CACHE_DIRECTORY=.cache/futures_prepared
FUTURES_RUNTIME_RESEARCH_TTL_SECONDS=604800
FUTURES_RUNTIME_HISTORY_TTL_SECONDS=604800
FUTURES_RUNTIME_NEWS_TTL_SECONDS=900
FUTURES_RUNTIME_WORKERS=4
FUTURES_RUNTIME_REQUEST_TIMEOUT_SECONDS=5
FUTURES_RUNTIME_RETRIES=1
FUTURES_RUNTIME_LIVE_DEADLINE_SECONDS=120
FUTURES_RUNTIME_LIVE_NEWS_BUDGET_SECONDS=12
FUTURES_RUNTIME_CANDLE_REFRESH_SECONDS=240
FUTURES_RUNTIME_QUOTE_INTERVAL_SECONDS=1.05
FUTURES_RUNTIME_HISTORICAL_INTERVAL_SECONDS=0.35
FUTURES_RUNTIME_REQUIRE_MARGIN=true
FUTURES_RUNTIME_MOVEMENT_BASIS=FUTURES

# Standalone additive Report D artifacts (no additional market requests).
FUTURES_REPORT_DIRECTORY=reports/prepared_scans

# Cache recovery and completed-session research (operational, not trading rules).
FUTURES_RUNTIME_LEGACY_REPORTS_DIRECTORY=reports
FUTURES_RUNTIME_AFTER_MARKET_DEADLINE_SECONDS=300
FUTURES_RUNTIME_AFTER_MARKET_NEWS_BUDGET_SECONDS=60
FUTURES_RUNTIME_AFTER_MARKET_ANALYSIS_BUDGET_SECONDS=60

# Report E hypotheses only. These do not change original scanner rules/scores.
FUTURES_REPORT_E_LONG_WEIGHTS={"technical":0.35,"volume":0.15,"fundamentals":0.25,"futures":0.15,"context":0.10}
FUTURES_REPORT_E_SHORT_WEIGHTS={"technical":0.40,"volume":0.15,"fundamentals":0.20,"futures":0.15,"context":0.10}
FUTURES_REPORT_E_QUALITY_RANK_WEIGHT=0.6
FUTURES_REPORT_E_STRONG_QUALITY_THRESHOLD=70
FUTURES_REPORT_E_STRONG_COVERAGE_PERCENT=80
FUTURES_REPORT_E_PREPARE_HISTORY=true
# Set only with an explicit historical full bid/ask spread assumption (basis points).
# FUTURES_REPORT_E_HISTORICAL_SPREAD_BPS=1

# Approved Futures correction: broker actions always read-only.
# Persistent path is relative to repository root, independent of shell cwd.
FUTURES_RUNTIME_LEDGER_PATH=data/futures_executions.sqlite3
FUTURES_RUNTIME_RECONCILIATION_MAX_AGE_SECONDS=120
FUTURES_SCAN_MAXIMUM_DAILY_ENTRIES=2
FUTURES_SCAN_ENTRY_CUTOFF_HOUR=15
FUTURES_SCAN_ENTRY_CUTOFF_MINUTE=15
FUTURES_SCAN_MANUAL_EXIT_WARNING_MINUTES=10
# Backtest/manual-exit deadline remains 15:20 IST; no automatic square-off.
FUTURES_SCAN_INTRADAY_EXIT_HOUR=15
FUTURES_SCAN_INTRADAY_EXIT_MINUTE=20

# Additive Futures Trading workspace. Existing scanner defaults above are preserved.
FUTURES_WORKSPACE_ENABLED=false
FUTURES_WORKSPACE_WEEKLY_HISTORY_SOURCE=yahoo_adjusted
FUTURES_WORKSPACE_REQUIRE_ADJUSTED_HISTORY=true
FUTURES_WORKSPACE_MINIMUM_SCORE=60
FUTURES_WORKSPACE_MAXIMUM_PER_LIST=25
# Adaptive 2 -> 4 -> 8 -> 16 -> ...; shared Kite pacing stays authoritative.
FUTURES_WORKSPACE_MAXIMUM_WORKERS=32
FUTURES_WORKSPACE_HEALTHY_PARALLEL_BATCHES=3
FUTURES_WORKSPACE_CONFIRMATION_SESSIONS=3
FUTURES_WORKSPACE_HYSTERESIS=8
FUTURES_WORKSPACE_RECOVERY_DECLINE_PERCENT=15
FUTURES_WORKSPACE_RECOVERY_DRAWDOWN_PERCENT=20
FUTURES_WORKSPACE_MAXIMUM_HISTORY_AGE_SESSIONS=2
FUTURES_WORKSPACE_MAXIMUM_MEMBERSHIP_AGE_DAYS=8
FUTURES_WORKSPACE_MINIMUM_FUTURES_VOLUME=1000
FUTURES_WORKSPACE_MAXIMUM_SPREAD_PERCENT=0.15
FUTURES_WORKSPACE_TECHNICAL_WEIGHT=0.7
FUTURES_WORKSPACE_FUNDAMENTAL_WEIGHT=0.2
FUTURES_WORKSPACE_NEWS_WEIGHT=0.1
# Context weights are reported only until independent validation.
FUTURES_WORKSPACE_CONTEXT_RANKING_VALIDATED=false
FUTURES_WORKSPACE_BIAS_DIRECTIONAL_THRESHOLD=20
FUTURES_WORKSPACE_BIAS_STRONG_THRESHOLD=60
# Saturday 09:00 Asia/Kolkata; most recent completed sessions, no weekend live assumption.
FUTURES_WORKSPACE_WEEKLY_DAY=5
FUTURES_WORKSPACE_WEEKLY_HOUR=9
FUTURES_WORKSPACE_WEEKLY_MINUTE=0
FUTURES_WORKSPACE_ENTRY_CUTOFF_HOUR=15
FUTURES_WORKSPACE_ENTRY_CUTOFF_MINUTE=0
FUTURES_WORKSPACE_FLAT_HOUR=15
FUTURES_WORKSPACE_FLAT_MINUTE=10
# Optional per-security adjustment provenance for Kite weekly history:
# FUTURES_WORKSPACE_ADJUSTMENT_MANIFEST=resources/verified_adjustments.json
